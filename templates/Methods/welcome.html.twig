{% extends chromeless ? 'base.chromeless.html.twig': 'base.html.twig' %}

{% block title %}Methods | {{ parent() }}{% endblock %}

{% block preload %}
	{% if not chromeless %}
	<link rel="preload" href="{{ preload(asset('images/search.svg'), {as: 'image', type: 'image/svg+xml'}) }}" as="image" type="image/svg+xml" />
	{% endif %}
	<link rel="preload" href="{{ preload(asset('images/external.svg'), {as: 'image', type: 'image/svg+xml'}) }}" as="image" type="image/svg+xml" />
{% endblock %}

{% block og_title %}Methods{% endblock %}
{% block og_description %}Method information for bellringers{% endblock %}

{% set breadcrumb = { 'title': 'Methods', 'href': path('Blueline_Methods_welcome') } %}

{% set search = true %}
{% set search_action = path( 'Blueline_Methods_search' ) %}
{% set search_placeholder = 'Search methods' %}

{% block body %}
	<section class="text">
		<div class="wrap">
			<p>Search for methods using the box above. Queries beginning with '/' will be interpreted as a <a href="https://en.wikipedia.org/wiki/Regular_expression" class="external">regular expression</a>.</p>
			<p>Not sure what to search for? <a href="{{ path( 'Blueline_Pages_view', { page: 'methods/discover' } ) }}">Discover popular methods</a>.</p>
			<p>The database is created from the <a href="http://methods.cccbr.org.uk" class="external">Central Council method collections</a> and was last updated on {{ db_age|date("Y-m-d") }}.</p>
		</div>

		<div class="starred-methods" hidden></div>

		<div class="wrap">
			<h2>Custom Method</h2>
			<p>To view a method not in the collections enter the stage and place notation below. Various abbreviated place notation formats are supported, <a href="{{ path( 'Blueline_Pages_view', {page: 'methods/notation'} ) }}">see here for a guide</a>.</p>
			<form id="custom_method" action="{{ path( 'Blueline_Methods_custom_view' ) }}">
				<div class="custom-method-fields">
				<div class="custom-method-field custom-method-stage">
					<label for="custom_method_stage">Stage</label>
					<div class="select-wrapper">
					<select id="custom_method_stage" name="stage">
						<option value="" disabled selected>…</option>
						<option value="4">4 - Minimus</option>
						<option value="5">5 - Doubles</option>
						<option value="6">6 - Minor</option>
						<option value="7">7 - Triples</option>
						<option value="8">8 - Major</option>
						<option value="9">9 - Caters</option>
						<option value="10">10 - Royal</option>
						<option value="11">11 - Cinques</option>
						<option value="12">12 - Maximus</option>
						<option value="13">13 - Sextuples</option>
						<option value="14">14 - Fourteen</option>
						<option value="15">15 - Septuples</option>
						<option value="16">16 - Sixteen</option>
						<option value="17">17 - Octuples</option>
						<option value="18">18 - Eighteen</option>
						<option value="19">19 - Nineteen</option>
						<option value="20">20 - Twenty</option>
						<option value="21">21 - Twenty-one</option>
						<option value="22">22 - Twenty-two</option>
					</select>
					</div>
				</div>
				<div class="custom-method-field custom-method-notation">
					<label for="custom_method_notation">Place Notation</label>
					<div class="input-wrapper">
						<input id="custom_method_notation" name="notation" type="text" placeholder="…" autocomplete="off" autocapitalize="none" />
					</div>
				</div>
				</div>
				<p id="custom_method_notationParsed" class="placeholder">…</p>
				<input type="submit" value="View" />
			</form>
		</div>
	</section>
{% endblock %}
