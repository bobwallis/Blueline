#!/bin/bash
set -euo pipefail

# Get script directory, and cd to the parent folder
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ] ; do SOURCE="$(readlink "$SOURCE")"; done
d="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
REPO_ROOT="$( cd "$d/.." && pwd )"
cd "$REPO_ROOT"

ENV_LOCAL_FILE="$REPO_ROOT/.env.local"
. "$REPO_ROOT/bin/deployment-functions"

usage() {
cat << EOF

Usage: $0 [options] [dev|test|prod]
Fetches external data and imports it into Blueline.

Options:
 --env=<env>   Set APP_ENV (dev, test, or prod)
 --nopull      Skip downloading external data before import
 --help, -h    Show this message
EOF
}

ENV_ARG=""
SKIP_PULL=0
for arg in "$@"; do
	case "$arg" in
		--help|-h)
			usage
			exit 0
			;;
		--env=*)
			ENV_ARG="${arg#*=}"
			;;
		--nopull)
			SKIP_PULL=1
			;;
		dev|test|prod)
			ENV_ARG="$arg"
			;;
	esac
done

if [ -n "$ENV_ARG" ]; then
	APP_ENV="$ENV_ARG"
else
	APP_ENV=""
	if [ -f "$ENV_LOCAL_FILE" ]; then
		APP_ENV="$(sed -nE 's/^[[:space:]]*APP_ENV[[:space:]]*=[[:space:]]*//p' "$ENV_LOCAL_FILE" | tail -n 1 | sed -E 's/[[:space:]]*$//' | sed -E 's/^"(.*)"$/\1/; s/^\x27(.*)\x27$/\1/')"
	fi
	if [ -z "$APP_ENV" ]; then
		APP_ENV="dev"
	fi
fi
case "$APP_ENV" in dev|test|prod) ;; *) echo "ERROR: Invalid application environment." >&2; exit 1 ;; esac
export APP_ENV
if [ "$APP_ENV" = test ]; then
	php -r 'require "vendor/autoload.php"; \Blueline\Helpers\TestEnvironmentGuard::assertSafe(getcwd());'
fi
load_maintenance_connection

if [ "$SKIP_PULL" -eq 0 ]; then
	# Download external data
	echo -e "\n\033[1mDownloading external data\033[0m"
	"./src/Resources/data/fetch"
	echo ""
fi

# Check database schema exists and is accessible, and create if not
echo -e "\n\033[1mChecking database schema\033[0m"
if [ "$APP_ENV" != prod ]; then
	symfony console doctrine:database:create --if-not-exists
fi
symfony console dbal:run-sql "CREATE EXTENSION IF NOT EXISTS fuzzystrmatch" --no-interaction

check_database_schema
if [ "$DATABASE_SCHEMA_OUT_OF_DATE" = true ]; then
	echo -e "\n\033[1mDatabase schema is out of date\033[0m"
	echo -e "\n\033[1mPending SQL updates\033[0m"
	symfony console doctrine:schema:update --dump-sql
	echo ""
	read -r -p "  Run forced schema update now? [y/N] " RUN_SCHEMA_UPDATE
	if [[ "$RUN_SCHEMA_UPDATE" =~ ^[Yy]$ ]]; then
		echo -e "\n\033[1mRunning forced schema update\033[0m"
		symfony console doctrine:schema:update --force
	else
		echo "  Skipping forced schema update."
	fi
fi

# Import updated method data
echo -e "\n\033[1mImporting method data\033[0m"
symfony console blueline:importMethods --no-debug --env="$APP_ENV"
symfony console blueline:importMethodExtras --no-debug --env="$APP_ENV"
symfony console blueline:importCollections --no-debug --env="$APP_ENV"
symfony console dbal:run-sql "VACUUM" --env="$APP_ENV"
symfony console blueline:calculateMethodSimilarities --no-debug --env="$APP_ENV"
symfony console dbal:run-sql "VACUUM" --env="$APP_ENV"
echo ""

# Update the database update timestamp in the .env file
if [ "$APP_ENV" = "dev" ]; then
	DATABASE_UPDATE_FILE="$ENV_LOCAL_FILE"
else
	DATABASE_UPDATE_FILE="$REPO_ROOT/.env.${APP_ENV}.local"
fi
touch "$DATABASE_UPDATE_FILE"
upsert_env_value DATABASE_UPDATE "$(date +%s)" "$DATABASE_UPDATE_FILE"
if [ "$APP_ENV" = prod ]; then
	unset DATABASE_URL
	dump_runtime_environment
	if id blueline-web >/dev/null 2>&1; then
		sudo setfacl -m u:blueline-web:r "$DATABASE_UPDATE_FILE"
	fi
	if [ -d /run/systemd/system ] && [ "$(systemctl show blueline.service --property=WorkingDirectory --value)" = "$REPO_ROOT" ]; then
		sudo systemctl restart blueline
	else
		echo "Production environment refreshed. Restart your manually managed web server to apply it."
	fi
fi
